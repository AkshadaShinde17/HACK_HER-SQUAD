function getGPS(){if(!navigator.geolocation){toast('GPS is not available in this browser.');return}toast('Requesting location permission…');navigator.geolocation.getCurrentPosition(pos=>{let s=pos.coords.latitude.toFixed(6)+', '+pos.coords.longitude.toFixed(6);$('gps').value=s;$('location-label').textContent='GPS: '+s;toast('GPS coordinates captured locally.')},()=>toast('Location permission denied or unavailable. Try HTTPS and allow location access.'),{enableHighAccuracy:true,timeout:10000})}
const cropData={Rice:{season:'Kharif (monsoon)',soil:'Reliable water and drainage are important; avoid assuming continuous flooding is always best.',fert:'Use soil-test-based nutrient planning. Organic matter may improve soil condition; urea and phosphate sources only at locally recommended rates.'},Wheat:{season:'Rabi (winter)',soil:'Cool-season conditions and timely irrigation are important.',fert:'Base NPK on soil testing and local wheat recommendations; split nitrogen timing matters.'},Cotton:{season:'Mostly Kharif',soil:'Long season; monitor moisture, weeds and pests frequently.',fert:'Use soil-test-based balanced nutrition and integrated pest management.'},Soybean:{season:'Kharif',soil:'Well-drained soil; waterlogging can be harmful.',fert:'Follow local soybean nutrient and inoculation guidance; avoid unnecessary nitrogen.'},Tomato:{season:'Varies by region',soil:'Drainage, disease pressure, variety and planting window matter.',fert:'Use crop-stage-based nutrient guidance from local horticulture experts.'},Onion:{season:'Varies by region and crop type',soil:'Good drainage and suitable planting window are important.',fert:'Use soil-test-based nutrient schedule; avoid excess nitrogen near maturity.'},Chickpea:{season:'Rabi',soil:'Generally needs well-drained soil.',fert:'Phosphorus and inoculants should follow local recommendations.'},Maize:{season:'Kharif / Rabi / Zaid depending on region',soil:'Needs suitable moisture and drainage.',fert:'Nitrogen timing and amount should match crop stage and local package.'},Sugarcane:{season:'Planting windows vary by region',soil:'Long-duration crop; water and nutrient needs vary widely.',fert:'Follow state agricultural university recommendations and soil test.'},Groundnut:{season:'Often Kharif; other windows region-specific',soil:'Loose, well-drained soil supports pod development.',fert:'Calcium, sulphur and other nutrients depend on soil and local advice.'}};
$('crop-form').addEventListener('submit',e=>{e.preventDefault();let c=$('crop-name').value,d=cropData[c],fert=$('fert-type').value,season=$('crop-season').value,soil=$('soil-type').value;let status=soil==='Not sure'||fert==='Not sure yet'?'yellow-dot':'green-dot';let label=status==='yellow-dot'?'NEEDS MORE INFORMATION':'INITIAL REVIEW';$('crop-review').innerHTML=`<div class="risk"><span class="circle ${status}"></span><div><strong>${label}: ${c}</strong><p>Typical season reference: ${d.season}. Your selected season is ${season}. Confirm the local sowing window and variety before planting.</p></div></div><div class="risk"><span class="circle orange-dot"></span><div><strong>Soil and water check</strong><p>${d.soil} Selected soil: ${soil}. A soil test and local recommendation are needed to confirm suitability.</p></div></div><div class="risk"><span class="circle yellow-dot"></span><div><strong>Nutrient review</strong><p>${d.fert} Selected input: ${fert}. No application rate is calculated because field-specific data is missing.</p></div></div><div class="risk"><span class="circle green-dot"></span><div><strong>Next best step</strong><p>Share your soil test, crop variety, sowing date and irrigation method with your local KVK/agriculture officer. Concern noted: ${$('crop-concern').value||'none entered'}.</p></div></div>`;toast('A preliminary review has been prepared.')});
let plans=[];function renderPlans(){let el=$('plan-list');el.innerHTML='';if(!plans.length){el.innerHTML='<div class="empty">No crop plans yet. Add your first crop on the left.</div>';return}plans.forEach((p,i)=>{let div=document.createElement('div');div.className='risk';div.innerHTML=`<span class="circle green-dot"></span><div style="flex:1"><strong>${escapeHtml(p.crop)} <span class="tag">${escapeHtml(p.season)}</span></strong><p>${escapeHtml(p.task||'No task entered')} · ${escapeHtml(p.time)} · ${escapeHtml(p.frequency)}${p.date?' · sowing '+escapeHtml(p.date):''}</p><label style="font-size:12px"><input type="checkbox" onchange="this.closest('.risk').style.opacity=this.checked?'.55':'1'"> Mark today's task done</label></div><button class="btn outline small" onclick="removePlan(${i})">Remove</button>`;el.appendChild(div)});$('stat-crops').textContent=plans.length}function removePlan(i){plans.splice(i,1);renderPlans()}function addCropPlan(){let c=$('crop-name').value;plans.push({crop:c,season:$('crop-season').value,task:'Inspect crop and check soil moisture',time:'07:00',frequency:'Daily',date:''});renderPlans();toast('Crop added to your plan.')}$('plan-form').addEventListener('submit',e=>{e.preventDefault();plans.push({crop:$('plan-crop').value,season:$('plan-season').value,date:$('plan-date').value,duration:$('plan-duration').value,task:$('plan-task').value,time:$('plan-time').value,frequency:$('plan-frequency').value});renderPlans();e.target.reset();$('plan-time').value='07:00';toast('Crop plan added.')});function enableNotifications(){if(!('Notification'in window)){toast('This browser does not support notifications.');return}Notification.requestPermission().then(p=>toast(p==='granted'?'Notifications allowed. This demo does not schedule background alarms.':'Notifications were not enabled.'))}
$('crop-photos').addEventListener('change',e=>{let el=$('photo-preview');el.innerHTML='';[...e.target.files].slice(0,6).forEach(f=>{let img=document.createElement('img');img.src=URL.createObjectURL(f);img.alt='Uploaded crop photo';el.appendChild(img)})});function prepareReport(){let files=$('crop-photos').files;let crop=$('rescue-crop').value,sym=$('symptom').value;let advice='';if(sym==='Yellowing leaves')advice='Possible causes include nutrient imbalance, water stress, root problems or disease. Check soil moisture and field pattern; do not assume a single cause.';else if(sym==='Spots or patches on leaves'||sym==='White powder / mould-like growth')advice='Photograph both sides of affected leaves and note spread after rain or humid weather. Ask a local expert to distinguish fungal, bacterial and other causes.';else if(sym==='Holes / chewing damage')advice='Inspect leaves at dawn or dusk for insects, eggs and frass. Confirm pest identity and local action threshold before selecting control.';else if(sym==='Wilting or drooping')advice='Check soil moisture, drainage and roots in a small sample. Water stress, root damage and wilt diseases can look similar.';else advice='Record affected plant parts, spread pattern, weather and recent inputs. A local expert should confirm the likely cause.';$('rescue-report').innerHTML=`<span class="tag orange">PRELIMINARY — NOT AN AI DIAGNOSIS</span><div class="risk"><span class="circle yellow-dot"></span><div><strong>${escapeHtml(crop)} · ${escapeHtml(sym)}</strong><p>${files.length} photo(s) selected. ${advice}</p></div></div><div class="step"><div class="step-num">1</div><div><b>Document</b><p>Keep the original photos and take a new photo from the same angle tomorrow.</p></div></div><div class="step"><div class="step-num">2</div><div><b>Check field conditions</b><p>Record recent rain, irrigation, fertiliser and any products already applied.</p></div></div><div class="step"><div class="step-num">3</div><div><b>Verify before treatment</b><p>Show photos and crop details to your KVK/agriculture officer. Use a registered product only if recommended for the crop and identified problem.</p></div></div><div class="hint warning">Estimated survival: not available. Treatment dose and timing: not generated without verified diagnosis and the exact registered product label.</div>`;toast('Symptom report prepared for expert review.')}
let journal=[];$('journal-date').value=new Date().toISOString().slice(0,10);$('journal-form').addEventListener('submit',e=>{e.preventDefault();let files=[...$('journal-photos').files].slice(0,3);let pics=files.map(f=>URL.createObjectURL(f));journal.unshift({date:$('journal-date').value,crop:$('journal-crop').value,type:$('journal-type').value,condition:$('journal-condition').value,notes:$('journal-notes').value,pics});renderJournal();e.target.reset();$('journal-date').value=new Date().toISOString().slice(0,10);toast('Farm update saved in this session.')});function renderJournal(){let el=$('journal-list');el.innerHTML='';if(!journal.length){el.innerHTML='<div class="card empty">Your saved updates will appear here.</div>'}journal.forEach(j=>{let d=document.createElement('div');d.className='card';d.innerHTML=`<span class="tag">${escapeHtml(j.type)}</span><h3 style="margin-top:10px">${escapeHtml(j.crop)}</h3><p>${escapeHtml(j.date)} · ${escapeHtml(j.condition)}</p><p>${escapeHtml(j.notes||'No notes added.')}</p><div class="preview">${j.pics.map(src=>`<img src="${src}" alt="Farm progress photo">`).join('')}</div>`;el.appendChild(d)});$('journal-count').textContent=journal.length;$('journal-improving').textContent=journal.filter(j=>j.condition==='Improving').length;$('journal-harvested').textContent=journal.filter(j=>j.condition==='Harvested').length;$('stat-photos').textContent=journal.reduce((a,j)=>a+j.pics.length,0)}function escapeHtml(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function updateTasks(){let checks=[...document.querySelectorAll('.task-check')];let done=checks.filter(c=>c.checked).length;$('stat-tasks').textContent=done+'/'+checks.length;toast('Checklist progress updated: '+done+' completed.')};document.querySelectorAll('.task-check').forEach(c=>c.addEventListener('change',()=>{let checks=[...document.querySelectorAll('.task-check')];$('stat-tasks').textContent=checks.filter(x=>x.checked).length+'/'+checks.length}));
const icons=['☀️','🌤️','🌦️','☁️','🌤️','☀️','🌦️'];const days=['Today','Mon','Tue','Wed','Thu','Fri','Sat'];$('forecast').innerHTML=days.map((d,i)=>`<div class="day"><small>${d}</small><div style="font-size:22px;margin:6px 0">${icons[i]}</div><b>--° / --°</b><small>Demo only</small></div>`).join('');
