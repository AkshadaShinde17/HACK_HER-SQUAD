#d8ebc7;color:var(--forest);width:37px;height:37px;border-radius:50%;display:grid;place-items:center;font-weight:800}.content{padding:30px 34px 55px;max-width:1500px;margin:auto}.page{display:none;animation:appear .3s ease}.page.active{display:block}@keyframes appear{from{opacity:.3;transform:translateY(6px)}to{opacity:1;transform:none}}.eyebrow{font-size:11px;letter-spacing:1.8px;text-transform:uppercase;color:var(--green);font-weight:800}.hero{min-height:300px;border-radius:26px;overflow:hidden;background:linear-gradient(90deg,#0d3628 0%,#12442ee8 44%,#12442e10 100%),url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1600&q=85') center/cover;color:white;padding:36px;display:flex;align-items:center;box-shadow:var(--shadow)}.hero-copy{max-width:570px}.hero h2{font:800 clamp(30px,3.2vw,45px)/1.13 Manrope;margin:12px 0}.hero p{line-height:1.7;color:#e1f0e3;max-width:490px}.btn{border:0;border-radius:12px;padding:12px 17px;background:var(--green);color:white;font-weight:700;transition:.2s;box-shadow:0 5px 12px #1e754c18}.btn:hover{background:var(--forest);transform:translateY(-2px)}.btn.light{background:#fff;color:var(--forest)}.btn.outline{background:transparent;border:1px solid var(--line);color:var(--ink);box-shadow:none}.btn.small{padding:9px 12px;font-size:12px}.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}.section-head{display:flex;justify-content:space-between;gap:16px;align-items:end;margin:28px 0 15px}.section-head h2,.page-title{font:800 25px Manrope;margin:5px 0}.section-head p{margin:0;color:var(--muted);font-size:13px}.grid{display:grid;gap:16px}.stats{grid-template-columns:repeat(4,minmax(0,1fr));margin-top:18px}.stat,.card{background:white;border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:var(--shadow)}.stat{display:flex;justify-content:space-between;gap:12px}.stat small{color:var(--muted);font-size:12px}.stat strong{display:block;font:800 27px Manrope;margin:8px 0 4px}.stat .stat-icon{width:42px;height:42px;border-radius:13px;background:var(--mint);display:grid;place-items:center;font-size:20px}.stat em{font-size:11px;color:var(--green);font-style:normal}.two-col{grid-template-columns:1.2fr .8fr}.three-col{grid-template-columns:repeat(3,minmax(0,1fr))}.four-col{grid-template-columns:repeat(4,minmax(0,1fr))}.card h3{font:800 17px Manrope;margin:0 0 8px}.card p{font-size:13px;line-height:1.65;color:var(--muted)}.news-item{display:flex;gap:13px;padding:13px 0;border-bottom:1px solid #edf2ec}.news-item:last-child{border:0}.news-dot{flex-shrink:0;width:38px;height:38px;border-radius:12px;background:#f4f0d9;display:grid;place-items:center}.news-item b{font-size:13px}.news-item p{margin:4px 0 0;font-size:12px}.tag{font-size:10px;font-weight:800;letter-spacing:.5px;border-radius:999px;padding:5px 8px;background:#edf6e8;color:#327144;display:inline-block}.tag.orange{background:#fff0dc;color:#a76315}.tag.red{background:#ffe7e3;color:#a33a30}.tag.yellow{background:#fff7d7;color:#8a7011}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:12px;font-weight:700;color:#385544}.field input,.field select,.field textarea{width:100%;border:1px solid #d7e4d7;background:#fbfdf9;border-radius:11px;padding:12px 13px;color:var(--ink);outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--leaf);box-shadow:0 0 0 3px #75b85a22}.field small{font-size:11px;color:var(--muted);line-height:1.5}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.hint{padding:13px 15px;background:#f1f7e8;border:1px solid #dceacb;border-radius:13px;color:#476747;font-size:12px;line-height:1.6;margin:14px 0}.warning{background:#fff5e7;border:1px solid #f1d7a9;color:#805b24}.risk{display:flex;gap:10px;align-items:flex-start;padding:12px;border-radius:12px;margin:9px 0;background:#f6f9f4}.risk strong{display:block;font-size:13px}.risk p{margin:3px 0 0;font-size:12px}.circle{width:12px;height:12px;border-radius:50%;flex-shrink:0;margin-top:3px}.red-dot{background:#dc5547}.orange-dot{background:#f0a340}.yellow-dot{background:#e7c441}.green-dot{background:#55a966}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:14px;margin-top:14px}table{width:100%;border-collapse:collapse;background:white;min-width:650px}th,td{text-align:left;padding:13px 14px;border-bottom:1px solid #edf2ec;font-size:12px;vertical-align:top}th{background:#f1f7ef;color:#45634c;font-size:11px;text-transform:uppercase;letter-spacing:.5px}tr:last-child td{border:0}.weather-big{background:linear-gradient(130deg,#1f754b,#123d2b);color:white;border-radius:20px;padding:24px;display:flex;justify-content:space-between;align-items:center}.weather-big p{color:#d4e8d8}.weather-temp{font:800 48px Manrope}.weather-icon{font-size:48px}.forecast{display:grid;grid-template-columns:repeat(7,minmax(75px,1fr));gap:8px;margin-top:14px}.day{background:#fff;border:1px solid var(--line);border-radius:13px;padding:12px 8px;text-align:center}.day small{font-size:11px;color:var(--muted)}.day b{display:block;margin:7px 0;font-size:13px}.upload{border:2px dashed #b8d3b8;border-radius:17px;padding:25px;text-align:center;background:#f9fcf6;cursor:pointer}.upload:hover{border-color:var(--green);background:#f0f8ed}.upload input{max-width:100%;margin-top:10px}.preview{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}.preview img{width:110px;height:90px;object-fit:cover;border-radius:12px;border:1px solid var(--line)}.progress{height:8px;border-radius:99px;background:#e8efe7;overflow:hidden;margin:10px 0}.progress span{display:block;height:100%;background:var(--leaf);border-radius:99px}.step{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid #edf2ec}.step:last-child{border:0}.step-num{flex-shrink:0;width:32px;height:32px;border-radius:10px;background:var(--mint);display:grid;place-items:center;color:var(--green);font-weight:800}.step b{font-size:13px}.step p{margin:4px 0}.checkrow{display:flex;gap:10px;align-items:center;padding:11px 0;border-bottom:1px solid #edf2ec;font-size:13px}.checkrow input{accent-color:var(--green)}.footer-note{font-size:11px;color:var(--muted);margin-top:22px;line-height:1.7}.mobile-menu{display:none}.empty{padding:28px;text-align:center;color:var(--muted)}.toast{position:fixed;bottom:20px;right:20px;background:var(--forest);color:white;padding:13px 18px;border-radius:12px;box-shadow:var(--shadow);display:none;z-index:20;font-size:13px}.language-chip{font-size:11px;color:var(--muted)}
